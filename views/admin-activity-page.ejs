<%- include('partials/header') %>
<%- include('partials/admin-tabs', { active: 'activity' }) %>
<p class="crumbs"><a href="/admin/activity">Reading activity</a> ›</p>
<h1 class="page-heading"><%= page.title %></h1>
<p class="muted">Last edited <%= fmtDate(page.updated) || 'unknown' %> · <a href="/pages/<%= page.slug %>">Open page</a></p>
<div class="card">
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>User</th><th>Status</th><th>First opened</th><th>Last opened</th><th>Visits</th></tr></thead>
    <tbody>
    <% rows.forEach(function (r) { %>
      <tr>
        <td><a href="/admin/activity/users/<%= encodeURIComponent(r.person.username) %>"><%= r.person.username %></a></td>
        <td><%- include('partials/admin-status', { status: r.status }) %></td>
        <td class="muted"><%= r.entry ? fmtDate(r.entry.firstViewed) : '—' %></td>
        <td class="muted"><%= r.entry ? fmtDate(r.entry.lastViewed) : '—' %></td>
        <td><%= r.entry ? r.entry.count : 0 %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('partials/footer') %>
