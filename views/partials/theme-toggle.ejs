<label class="theme-switch" title="Switch between light and dark mode">
  <span class="theme-icon" aria-hidden="true">☀</span>
  <input type="checkbox" role="switch" data-theme-toggle aria-label="Dark mode">
  <span class="theme-track" aria-hidden="true"><span class="theme-thumb"></span></span>
  <span class="theme-icon" aria-hidden="true">☾</span>
</label>
