<%- include('partials/header') %>
<section class="hero">
  <h1>How do I… in Windchill?</h1>
  <p class="muted">Search <%= total %> step-by-step guide<%= total === 1 ? '' : 's' %> by keyword, or pick a topic below.</p>
  <form class="hero-search" action="/search" method="get" role="search">
    <input type="search" name="q" placeholder="Search for a task or keyword…" aria-label="Search guides" autocomplete="off" autofocus data-suggest>
    <div class="suggest" hidden></div>
    <button class="btn" type="submit">Search</button>
  </form>
</section>

<nav class="section-tiles" aria-label="Topics">
  <% sections.forEach(function (s) { %>
  <a class="section-tile" href="/sections/<%= s.slug %>">
    <span class="section-icon"><%- include('partials/icon', { name: s.icon }) %></span>
    <span class="section-name"><%= s.name %></span>
    <span class="section-desc"><%= s.description %></span>
    <span class="section-count"><%= s.pages.length %> guide<%= s.pages.length === 1 ? '' : 's' %><% if (s.pages.length) { %> · <%= s.readCount %> read<% } %></span>
  </a>
  <% }) %>
</nav>

<% if (total === 0) { %>
  <div class="card empty">
    <h2>No guides yet</h2>
    <% if (can('editor')) { %><p><a class="btn" href="/new">Create the first page</a></p><% } else { %><p class="muted">Check back soon.</p><% } %>
  </div>
<% } else { %>
<section class="card all-pages" data-page-list>
  <div class="list-head">
    <div>
      <h2>All guides</h2>
      <div class="progress" title="<%= readCount %> of <%= total %> read">
        <progress max="<%= total %>" value="<%= readCount %>"></progress>
        <span class="muted">You've opened <strong><%= readCount %></strong> of <%= total %></span>
      </div>
    </div>
    <div class="list-controls">
      <input type="search" placeholder="Filter this list…" aria-label="Filter guides" data-filter>
      <div class="tabs" role="tablist" aria-label="Show">
        <button type="button" role="tab" aria-selected="true" data-show="all">All</button>
        <button type="button" role="tab" aria-selected="false" data-show="unread">Not read</button>
      </div>
    </div>
  </div>

  <% sections.forEach(function (s) { %>
  <div class="page-group" id="topic-<%= s.slug %>" data-group>
    <h3><a href="/sections/<%= s.slug %>"><%= s.name %></a> <span class="count"><%= s.pages.length %></span></h3>
    <% if (!s.pages.length) { %>
      <p class="muted group-empty" data-group-empty>No guides in this topic yet.<% if (can('editor')) { %> <a href="/new?section=<%= s.slug %>">Add one →</a><% } %></p>
    <% } %>
    <ul class="page-rows">
      <% s.pages.forEach(function (p) { const st = statusOf(p); %>
      <li class="page-row" data-status="<%= st %>" data-text="<%= [p.title, p.summary, p.tags.join(' '), s.name].join(' ').toLowerCase() %>">
        <a href="/pages/<%= p.slug %>">
          <span class="page-row-title"><%= p.title %></span>
          <% if (p.summary) { %><span class="page-row-summary"><%= p.summary %></span><% } %>
        </a>
        <%- include('partials/status-badge', { status: st }) %>
      </li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
  <p class="muted empty" data-no-match hidden>No guides match that filter. <a href="#" data-search-link>Search all content instead →</a></p>
</section>
<% if (tags.length) { %>
<section class="popular-tags">
  <h2>Popular keywords</h2>
  <div class="tags"><% tags.forEach(function (t) { %><a class="tag" href="/tags/<%= encodeURIComponent(t.name) %>"><%= t.name %></a><% }) %></div>
</section>
<% } %>
<% } %>
<%- include('partials/footer') %>
